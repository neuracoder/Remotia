# Token del bot de Telegram (obtenelo con @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Tu chat ID (obtenelo con @userinfobot o @getidsbot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Tiempo máximo de espera en segundos (default: 480 = 8 minutos)
REMOTIA_TIMEOUT_SECONDS=480

# Acción al agotarse el tiempo sin respuesta desde Telegram:
#   deny  → cancelar la acción (default, más seguro)
#   allow → aceptar la acción automáticamente
REMOTIA_TIMEOUT_ACTION=deny

# Ruta del archivo de log (default: ~/.remotia/remotia.log)
# REMOTIA_LOG_FILE=/home/tu_usuario/.remotia/remotia.log
